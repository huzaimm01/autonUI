<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>800</width><height>900</height></rect>
  </property>
  <property name="windowTitle">
   <string>FRC Auton Path Planner</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="verticalLayout">

    <item>
     <widget class="QComboBox" name="gameSelect"/>
    </item>

    <item>
     <widget class="QCheckBox" name="officialFieldCheck">
      <property name="text">
       <string>Use Official FRC Field Layout</string>
      </property>
     </widget>
    </item>

    <item>
     <widget class="QGroupBox" name="fieldBox">
      <property name="title"><string>Field Size (m)</string></property>
      <layout class="QHBoxLayout">
       <item><widget class="QLineEdit" name="fieldWidth"/></item>
       <item><widget class="QLineEdit" name="fieldLength"/></item>
      </layout>
     </widget>
    </item>

    <item>
     <widget class="QGroupBox" name="robotBox">
      <property name="title"><string>Robot Dimensions (m)</string></property>
      <layout class="QHBoxLayout">
       <item><widget class="QLineEdit" name="robotWidth"/></item>
       <item><widget class="QLineEdit" name="robotLength"/></item>
       <item><widget class="QLineEdit" name="robotHeight"/></item>
      </layout>
     </widget>
    </item>

    <item>
     <widget class="QGroupBox" name="startGoalBox">
      <property name="title"><string>Start and Goal Coordinates</string></property>
      <layout class="QGridLayout">
       <item row="0" column="0">
        <widget class="QLabel"><property name="text"><string>Start (x, y)</string></property></widget>
       </item>
       <item row="0" column="1"><widget class="QLineEdit" name="startX"/></item>
       <item row="0" column="2"><widget class="QLineEdit" name="startY"/></item>
       <item row="1" column="0">
        <widget class="QLabel"><property name="text"><string>Goal (x, y)</string></property></widget>
       </item>
       <item row="1" column="1"><widget class="QLineEdit" name="goalX"/></item>
       <item row="1" column="2"><widget class="QLineEdit" name="goalY"/></item>
      </layout>
     </widget>
    </item>

    <item>
     <widget class="QPushButton" name="planButton">
      <property name="text"><string>Plan Path</string></property>
     </widget>
    </item>

    <item>
     <widget class="QTextEdit" name="resultBox"/>
    </item>

    <item>
     <widget class="QWidget" name="openGLContainer">
      <property name="minimumHeight">
       <number>400</number>
      </property>
    </widget>
    </item>

   </layout>
  </widget>
 </widget>
 <resources/>
 <connections/>
</ui>

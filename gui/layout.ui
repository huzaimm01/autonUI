<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1250</width><height>850</height></rect></property>
  <property name="windowTitle"><string>FRC Auton Path Planner</string></property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QHBoxLayout" name="horizontalLayout">

    <item>
     <widget class="QSplitter" name="mainSplitter" orientation="Qt::Horizontal">

      <!-- SIDEBAR PANEL -->
      <widget class="QWidget" name="sidebar">
       <layout class="QVBoxLayout" name="sidebarLayout">

        <item><widget class="QLabel" name="sectionGameLabel">
         <property name="text"><string>Game Selection</string></property>
        </widget></item>
        <item><widget class="QComboBox" name="gameSelect"/></item>

        <item><widget class="QCheckBox" name="officialFieldCheck">
         <property name="text"><string>Use Official Field Layout</string></property>
        </widget></item>

        <item><widget class="QGroupBox" name="fieldBox">
         <property name="title"><string>Field Size (m)</string></property>
         <layout class="QHBoxLayout">
          <item><widget class="QLineEdit" name="fieldWidth"/></item>
          <item><widget class="QLineEdit" name="fieldLength"/></item>
         </layout>
        </widget></item>

        <item><widget class="QGroupBox" name="robotBox">
         <property name="title"><string>Robot Dimensions (m)</string></property>
         <layout class="QHBoxLayout">
          <item><widget class="QLineEdit" name="robotWidth"/></item>
          <item><widget class="QLineEdit" name="robotLength"/></item>
          <item><widget class="QLineEdit" name="robotHeight"/></item>
         </layout>
        </widget></item>

        <item><widget class="QGroupBox" name="startBox">
         <property name="title"><string>Start Coordinate</string></property>
         <layout class="QHBoxLayout">
          <item><widget class="QLineEdit" name="startX"/></item>
          <item><widget class="QLineEdit" name="startY"/></item>
         </layout>
        </widget></item>

        <item><widget class="QGroupBox" name="goalBox">
         <property name="title"><string>Goal Points</string></property>
         <layout class="QVBoxLayout">
          <item><widget class="QListWidget" name="goalList"/></item>
          <item>
           <layout class="QHBoxLayout">
            <item><widget class="QLineEdit" name="goalX"/></item>
            <item><widget class="QLineEdit" name="goalY"/></item>
            <item><widget class="QPushButton" name="addGoalButton">
             <property name="text"><string>Add</string></property>
            </widget></item>
           </layout>
          </item>
          <item>
           <layout class="QHBoxLayout">
            <item><widget class="QPushButton" name="removeGoalButton">
             <property name="text"><string>Remove Selected</string></property>
            </widget></item>
            <item><widget class="QPushButton" name="clearGoalsButton">
             <property name="text"><string>Clear Goals</string></property>
            </widget></item>
           </layout>
          </item>
         </layout>
        </widget></item>

        <item><widget class="QPushButton" name="planButton">
         <property name="text"><string>Plan Path</string></property>
        </widget></item>

        <item><widget class="QTextEdit" name="resultBox">
         <property name="readOnly"><bool>true</bool></property>
        </widget></item>

       </layout>
      </widget>

      <!-- FIELD PREVIEW PANEL -->
      <widget class="QWidget" name="fieldContainer">
       <layout class="QVBoxLayout">
        <item><widget class="QLabel" name="fieldLabel">
         <property name="text"><string>Field Preview</string></property>
        </widget></item>
        <item><widget class="QWidget" name="openGLContainer">
         <property name="minimumSize"><size><width>700</width><height>600</height></size></property>
        </widget></item>
       </layout>
      </widget>

     </widget>
    </item>

   </layout>
  </widget>
 </widget>
 <resources/>
 <connections/>
</ui>
